@model List<BusBooking_MVC.Models.Booking.BookingReadVm>

<div class="container mt-4">
    <h3 class="text-primary">📌 My Bookings</h3>

    @if (TempData["CancelMessage"] != null)
    {
        <div class="alert alert-info">@TempData["CancelMessage"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning mt-3">No bookings found.</div>
    }
    else
    {
        <table class="table table-bordered table-striped mt-3">
            <thead class="table-dark">
                <tr>
                    <th>BookingId</th>
                    <th>Bus</th>
                    <th>Date</th>
                    <th>Seats</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Cancel</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.BookingId</td>
                    <td>@b.BusName</td>
                    <td>@b.TravelDate.ToString("yyyy-MM-dd")</td>
                    <td>@string.Join(",", b.SeatNumbers)</td>
                    <td>₹@b.Amount</td>
                    <td>
                        @if (b.IsCancelled)
                        {
                            <span class="badge bg-danger">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@b.PaymentStatus</span>
                        }
                    </td>
                    <td>
                        @if (!b.IsCancelled)
                        {
                            <form asp-action="Cancel" method="post">
                                <input type="hidden" name="bookingId" value="@b.BookingId" />
                                <button class="btn btn-danger btn-sm">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }

    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-dark mt-2">Back</a>
</div>