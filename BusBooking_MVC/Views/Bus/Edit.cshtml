@model BusBooking_MVC.Models.BusUpdate

@{
    ViewData["Title"] = "Edit Bus";
}

<h2>Edit Bus</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">Bus Name</label>
        <input asp-for="BusName" class="form-control" />
        <span asp-validation-for="BusName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Total Seats</label>
        <input asp-for="TotalSeats" class="form-control" />
        <span asp-validation-for="TotalSeats" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Price</label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Route Id</label>
        <input asp-for="RouteId" class="form-control" />
        <span asp-validation-for="RouteId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="Manage" class="btn btn-secondary">Back</a>
</form>