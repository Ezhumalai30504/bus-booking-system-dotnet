@model BusBooking_MVC.Models.BusSearchRequest
@using BusBooking_MVC.Models

@{
    ViewData["Title"] = "Search Buses";
    var results = ViewBag.SearchResults as List<BusSearchResult>;
    var today = DateTime.Today.ToString("yyyy-MM-dd");   // ✅ ADD THIS
}

<div class="container mt-4">

    <h2 class="mb-4">Search Buses</h2>

    <!-- 🔍 Search Form -->
    <form asp-action="Search" asp-controller="BusRoute" method="post" class="row g-3">

        <div class="col-md-4">
            <label class="form-label">From</label>
            <input asp-for="FromCity" class="form-control" placeholder="Enter From City" />
            <span asp-validation-for="FromCity" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">To</label>
            <input asp-for="ToCity" class="form-control" placeholder="Enter To City" />
            <span asp-validation-for="ToCity" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">Travel Date</label>

            <!-- ✅ UPDATED: min + required -->
            <input asp-for="TravelDate"
                   type="date"
                   class="form-control"
                   min="@today"
                   required />

            <span asp-validation-for="TravelDate" class="text-danger"></span>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary">Search</button>
        </div>
        @* <div>
            <a class="btn btn-dark mt-3" asp-controller="BusRoute" asp-action="ListRoute">
            Back to Routes
        </a>
        </div> *@
        

    </form>

    <!-- 🔎 Search Results -->
    @if (results != null)
    {
        <hr />

        if (!results.Any())
        {
            <div class="alert alert-warning mt-3">
                No buses found.
            </div>
        }
        else
        {
            <h4 class="mt-3">Available Buses</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-striped mt-2">
                    <thead class="table-dark">
                        <tr>
                            <th>Bus Name</th>
                            <th>Total Seats</th>
                            <th>Available Seats</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var bus in results)
                        {
                            <tr>
                                <td>@bus.BusName</td>
                                <td>@bus.TotalSeats</td>

                                <td>
                                    @if (bus.AvailableSeats > 0)
                                    {
                                        <span class="text-success fw-bold">@bus.AvailableSeats</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">Full</span>
                                    }
                                </td>

                                <td>
                                    @if (bus.AvailableSeats > 0)
                                    {
                                        <a asp-controller="Booking"
                                           asp-action="Create"
                                           asp-route-busId="@bus.Id"
                                           asp-route-travelDate="@Model.TravelDate.ToString("yyyy-MM-dd")"
                                           class="btn btn-success btn-sm">
                                            🚌 Book Now
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-secondary btn-sm" disabled>Full</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}