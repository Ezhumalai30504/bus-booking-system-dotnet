@model BusBooking_MVC.Models.BusRoute

@{
    ViewData["Title"] = "Edit Route";
}

<h2>Edit Bus Route</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label class="form-label">From City</label>
        <input asp-for="FromCity" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">To City</label>
        <input asp-for="ToCity" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Update</button>
    <a asp-action="ListRoute" class="btn btn-secondary">Back</a>
</form>
