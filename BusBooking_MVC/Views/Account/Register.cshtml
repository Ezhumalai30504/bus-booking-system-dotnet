@model BusBooking_MVC.Models.Register

@{
    ViewData["Title"] = "User Register";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white text-center">
                    <h4>📝 User Registration</h4>
                </div>

                <div class="card-body">

                    <form asp-action="Register" autocomplete="off"  method="post">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Email" type="email" autocomplete="off" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input asp-for="Password" type="password" autocomplete="new-password" class="form-control" />
                            <span asp-validation-for="Password"  class="text-danger"></span>
                        </div>

                        <div class="text-center">
                            <button type="submit" class="btn btn-success w-100">
                                Register
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <a asp-action="Login">Already have an account? Login</a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}